{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendataproducts.org/odph-v0.2/schema/kentaro-change.yaml",
  "title": "Kentaro Change Control 0.2 Draft",
  "description": "A thin control schema for Kentaro-created business changes. It does not remodel objectives, use cases, data products, or graph connections. Those artefacts live in separately validated ODPC, ODPS, and ODPG YAML files. KentaroAction controls one direct Maysano API operation. KentaroChangeTask groups ordered action files for a later multi-action capability.",
  "oneOf": [
    {
      "$ref": "#/$defs/KentaroAction"
    },
    {
      "$ref": "#/$defs/KentaroChangeTask"
    }
  ],
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "Identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "Revision": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "RelativeYamlFile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.ya?ml$"
    },
    "Metadata": {
      "type": "object",
      "required": [
        "id",
        "title",
        "requestedBy",
        "createdAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "title": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "requestedBy": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "parentTestCase": {
          "$ref": "#/$defs/Identifier"
        },
        "parentChangeTask": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "additionalProperties": false
    },
    "ObjectReference": {
      "type": "object",
      "required": [
        "id",
        "expectedVersion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "expectedVersion": {
          "$ref": "#/$defs/Revision"
        },
        "specificationFamily": {
          "enum": [
            "ODPC",
            "ODPS",
            "ODPG"
          ]
        }
      },
      "additionalProperties": false
    },
    "GraphContext": {
      "type": "object",
      "required": [
        "source",
        "baseGraphRevision"
      ],
      "properties": {
        "source": {
          "const": "maysano"
        },
        "baseGraphRevision": {
          "$ref": "#/$defs/Revision"
        },
        "requiredObjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectReference"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "Intent": {
      "type": "object",
      "required": [
        "businessOwner",
        "reason",
        "expectedOutcome",
        "policyProfile"
      ],
      "properties": {
        "businessOwner": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "expectedOutcome": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "policyProfile": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "additionalProperties": false
    },
    "Review": {
      "type": "object",
      "required": [
        "requiredRoles"
      ],
      "properties": {
        "requiredRoles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "uniqueItems": true
        },
        "approvalExpiresAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "additionalProperties": false
    },
    "AcceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      }
    },
    "SpecificationChange": {
      "description": "The referenced YAML file is generated by Kentaro and validated separately against the declared ODPC, ODPS, or ODPG schema before submission to Maysano. Object identity and domain content come from that file.",
      "type": "object",
      "required": [
        "operation",
        "family",
        "file",
        "sha256"
      ],
      "properties": {
        "operation": {
          "enum": [
            "create",
            "update"
          ]
        },
        "family": {
          "enum": [
            "ODPC",
            "ODPS",
            "ODPG"
          ]
        },
        "file": {
          "$ref": "#/$defs/RelativeYamlFile"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "expectedVersion": {
          "$ref": "#/$defs/Revision"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "update"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "required": [
              "expectedVersion"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "ActionReference": {
      "description": "A reference to a separately validated KentaroAction YAML file. Dependency identifiers refer to action IDs in the same Change Task.",
      "type": "object",
      "required": [
        "id",
        "actionFile"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "actionFile": {
          "$ref": "#/$defs/RelativeYamlFile"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "KentaroAction": {
      "type": "object",
      "required": [
        "schema",
        "version",
        "kind",
        "metadata",
        "graphContext",
        "intent",
        "specification",
        "review",
        "acceptanceCriteria"
      ],
      "properties": {
        "schema": {
          "enum": [
            "https://opendataproducts.org/odph-v0.2/schema/kentaro-change.yaml",
            "https://opendataproducts.org/odph-v0.2/schema/kentaro-change.json"
          ]
        },
        "version": {
          "const": "0.2-draft"
        },
        "kind": {
          "const": "KentaroAction"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "graphContext": {
          "$ref": "#/$defs/GraphContext"
        },
        "intent": {
          "$ref": "#/$defs/Intent"
        },
        "specification": {
          "$ref": "#/$defs/SpecificationChange"
        },
        "review": {
          "$ref": "#/$defs/Review"
        },
        "acceptanceCriteria": {
          "$ref": "#/$defs/AcceptanceCriteria"
        }
      },
      "additionalProperties": false
    },
    "KentaroChangeTask": {
      "type": "object",
      "required": [
        "schema",
        "version",
        "kind",
        "metadata",
        "graphContext",
        "intent",
        "actions",
        "review",
        "acceptanceCriteria"
      ],
      "properties": {
        "schema": {
          "enum": [
            "https://opendataproducts.org/odph-v0.2/schema/kentaro-change.yaml",
            "https://opendataproducts.org/odph-v0.2/schema/kentaro-change.json"
          ]
        },
        "version": {
          "const": "0.2-draft"
        },
        "kind": {
          "const": "KentaroChangeTask"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "graphContext": {
          "$ref": "#/$defs/GraphContext"
        },
        "intent": {
          "$ref": "#/$defs/Intent"
        },
        "actions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/ActionReference"
          }
        },
        "review": {
          "$ref": "#/$defs/Review"
        },
        "acceptanceCriteria": {
          "$ref": "#/$defs/AcceptanceCriteria"
        }
      },
      "additionalProperties": false
    }
  }
}
