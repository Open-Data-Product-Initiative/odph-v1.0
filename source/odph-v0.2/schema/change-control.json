{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendataproducts.org/odph-v0.2/schema/change-control.yaml",
  "title": "Business Harness Model",
  "description": "Shape validation for six top-level ODPH governed-work objects: ContextPackage, Mandate, WorkEnvelope, ExecutionPackage, ExecutionRequest, and EvidenceEvent. ChangeAction and ChangeTask are peer top-level change-control objects. Cross-object references, subset checks, freshness, approvals, revocation, and platform enforcement require deterministic relationship validation.",
  "oneOf": [
    {
      "$ref": "#/$defs/ContextPackage"
    },
    {
      "$ref": "#/$defs/Mandate"
    },
    {
      "$ref": "#/$defs/WorkEnvelope"
    },
    {
      "$ref": "#/$defs/ExecutionPackage"
    },
    {
      "$ref": "#/$defs/ExecutionRequest"
    },
    {
      "$ref": "#/$defs/EvidenceEvent"
    },
    {
      "$ref": "#/$defs/ChangeAction"
    },
    {
      "$ref": "#/$defs/ChangeTask"
    }
  ],
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "Identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "Revision": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "StringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      }
    },
    "MultilingualText": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/NonEmptyString"
      }
    },
    "Reference": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "retrievedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "objectType": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "uri": {
          "type": "string",
          "format": "uri-reference"
        }
      },
      "additionalProperties": false
    },
    "ObjectMetadata": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "version",
        "createdAt",
        "actor"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/MultilingualText"
        },
        "description": {
          "$ref": "#/$defs/MultilingualText"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "actor": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "ObjectProvenance": {
      "type": "object",
      "required": [
        "sourceReferences",
        "relationshipReferences"
      ],
      "properties": {
        "sourceReferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "relationshipReferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        }
      },
      "additionalProperties": false
    },
    "CommonObject": {
      "type": "object",
      "required": [
        "kind",
        "metadata",
        "provenance"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/ObjectMetadata"
        },
        "provenance": {
          "$ref": "#/$defs/ObjectProvenance"
        }
      }
    },
    "Boundary": {
      "type": "object",
      "required": [
        "scope",
        "tools",
        "dataAccess",
        "approvalRights",
        "authorityLevel"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/StringList"
        },
        "tools": {
          "$ref": "#/$defs/StringList"
        },
        "dataAccess": {
          "$ref": "#/$defs/StringList"
        },
        "approvalRights": {
          "$ref": "#/$defs/StringList"
        },
        "authorityLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "RelativeYamlFile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.ya?ml$"
    },
    "Metadata": {
      "type": "object",
      "required": [
        "id",
        "title",
        "requestedBy",
        "createdAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "title": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "requestedBy": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "parentTestCase": {
          "$ref": "#/$defs/Identifier"
        },
        "parentChangeTask": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "additionalProperties": false
    },
    "ObjectReference": {
      "type": "object",
      "required": [
        "id",
        "expectedVersion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "expectedVersion": {
          "$ref": "#/$defs/Revision"
        },
        "specificationFamily": {
          "enum": [
            "ODPC",
            "ODPS",
            "ODPG"
          ]
        }
      },
      "additionalProperties": false
    },
    "GraphContext": {
      "type": "object",
      "required": [
        "source",
        "baseGraphRevision"
      ],
      "properties": {
        "source": {
          "const": "maysano"
        },
        "baseGraphRevision": {
          "$ref": "#/$defs/Revision"
        },
        "requiredObjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectReference"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "Intent": {
      "type": "object",
      "required": [
        "businessOwner",
        "reason",
        "expectedOutcome",
        "policyProfile"
      ],
      "properties": {
        "businessOwner": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "expectedOutcome": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "policyProfile": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "additionalProperties": false
    },
    "Review": {
      "type": "object",
      "required": [
        "requiredRoles"
      ],
      "properties": {
        "requiredRoles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "uniqueItems": true
        },
        "approvalExpiresAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "additionalProperties": false
    },
    "AcceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      }
    },
    "SpecificationChange": {
      "description": "The referenced YAML file is generated by ODPH and validated separately against the declared ODPC, ODPS, or ODPG schema before submission to Maysano. Object identity and domain content come from that file.",
      "type": "object",
      "required": [
        "operation",
        "family",
        "file",
        "sha256"
      ],
      "properties": {
        "operation": {
          "enum": [
            "create",
            "update"
          ]
        },
        "family": {
          "enum": [
            "ODPC",
            "ODPS",
            "ODPG"
          ]
        },
        "file": {
          "$ref": "#/$defs/RelativeYamlFile"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "expectedVersion": {
          "$ref": "#/$defs/Revision"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "update"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "required": [
              "expectedVersion"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "ActionReference": {
      "description": "A reference to a separately validated ChangeAction YAML file. Dependency identifiers refer to action IDs in the same Change Task.",
      "type": "object",
      "required": [
        "id",
        "actionFile"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "actionFile": {
          "$ref": "#/$defs/RelativeYamlFile"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "ContextPackage": {
      "allOf": [
        {
          "$ref": "#/$defs/CommonObject"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "metadata",
            "provenance",
            "context"
          ],
          "properties": {
            "kind": {
              "const": "ContextPackage"
            },
            "metadata": {
              "$ref": "#/$defs/ObjectMetadata"
            },
            "provenance": {
              "$ref": "#/$defs/ObjectProvenance"
            },
            "context": {
              "type": "object",
              "required": [
                "retrievalScope",
                "freshness",
                "conflicts"
              ],
              "properties": {
                "retrievalScope": {
                  "type": "object"
                },
                "freshness": {
                  "enum": [
                    "fresh",
                    "stale",
                    "unknown"
                  ]
                },
                "conflicts": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Mandate": {
      "allOf": [
        {
          "$ref": "#/$defs/CommonObject"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "metadata",
            "provenance",
            "mandate",
            "boundary"
          ],
          "properties": {
            "kind": {
              "const": "Mandate"
            },
            "metadata": {
              "$ref": "#/$defs/ObjectMetadata"
            },
            "provenance": {
              "$ref": "#/$defs/ObjectProvenance"
            },
            "mandate": {
              "type": "object",
              "required": [
                "businessArea",
                "owner",
                "expiresAt"
              ],
              "properties": {
                "businessArea": {
                  "$ref": "#/$defs/NonEmptyString"
                },
                "owner": {
                  "$ref": "#/$defs/NonEmptyString"
                },
                "expiresAt": {
                  "$ref": "#/$defs/Timestamp"
                }
              },
              "additionalProperties": false
            },
            "boundary": {
              "$ref": "#/$defs/Boundary"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "WorkEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/CommonObject"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "metadata",
            "provenance",
            "assignment",
            "boundary"
          ],
          "properties": {
            "kind": {
              "const": "WorkEnvelope"
            },
            "metadata": {
              "$ref": "#/$defs/ObjectMetadata"
            },
            "provenance": {
              "$ref": "#/$defs/ObjectProvenance"
            },
            "assignment": {
              "type": "object",
              "required": [
                "mandateReference",
                "requestedResult",
                "owner",
                "expiresAt"
              ],
              "properties": {
                "mandateReference": {
                  "$ref": "#/$defs/Reference"
                },
                "requestedResult": {
                  "$ref": "#/$defs/NonEmptyString"
                },
                "owner": {
                  "$ref": "#/$defs/NonEmptyString"
                },
                "expiresAt": {
                  "$ref": "#/$defs/Timestamp"
                }
              },
              "additionalProperties": false
            },
            "boundary": {
              "$ref": "#/$defs/Boundary"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ExecutionPackage": {
      "allOf": [
        {
          "$ref": "#/$defs/CommonObject"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "metadata",
            "provenance",
            "execution",
            "boundary",
            "plan"
          ],
          "properties": {
            "kind": {
              "const": "ExecutionPackage"
            },
            "metadata": {
              "$ref": "#/$defs/ObjectMetadata"
            },
            "provenance": {
              "$ref": "#/$defs/ObjectProvenance"
            },
            "execution": {
              "type": "object",
              "required": [
                "workEnvelopeReference"
              ],
              "properties": {
                "workEnvelopeReference": {
                  "$ref": "#/$defs/Reference"
                }
              },
              "additionalProperties": false
            },
            "boundary": {
              "$ref": "#/$defs/Boundary"
            },
            "plan": {
              "type": "object",
              "required": [
                "plannedSteps",
                "expectedOutputs",
                "dependencies",
                "timing",
                "acceptanceCriteria"
              ],
              "properties": {
                "plannedSteps": {
                  "$ref": "#/$defs/StringList"
                },
                "expectedOutputs": {
                  "$ref": "#/$defs/StringList"
                },
                "dependencies": {
                  "$ref": "#/$defs/StringList"
                },
                "timing": {
                  "$ref": "#/$defs/NonEmptyString"
                },
                "acceptanceCriteria": {
                  "$ref": "#/$defs/StringList"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ExecutionRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/CommonObject"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "metadata",
            "provenance",
            "execution",
            "request"
          ],
          "properties": {
            "kind": {
              "const": "ExecutionRequest"
            },
            "metadata": {
              "$ref": "#/$defs/ObjectMetadata"
            },
            "provenance": {
              "$ref": "#/$defs/ObjectProvenance"
            },
            "execution": {
              "type": "object",
              "required": [
                "workEnvelopeReference",
                "revocationPolicyReference"
              ],
              "properties": {
                "workEnvelopeReference": {
                  "$ref": "#/$defs/Reference"
                },
                "executionPackageReference": {
                  "$ref": "#/$defs/Reference",
                  "description": "Optional separately reviewed plan for complex action delivery."
                },
                "revocationPolicyReference": {
                  "$ref": "#/$defs/Reference"
                }
              },
              "additionalProperties": false
            },
            "request": {
              "type": "object",
              "required": [
                "action",
                "tool",
                "target",
                "requestedAuthority",
                "approval"
              ],
              "properties": {
                "action": {
                  "$ref": "#/$defs/NonEmptyString"
                },
                "tool": {
                  "$ref": "#/$defs/NonEmptyString"
                },
                "target": {
                  "$ref": "#/$defs/NonEmptyString"
                },
                "requestedAuthority": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "approval": {
                  "type": "object",
                  "required": [
                    "required",
                    "expiresAt"
                  ],
                  "properties": {
                    "required": {
                      "type": "boolean"
                    },
                    "expiresAt": {
                      "oneOf": [
                        {
                          "$ref": "#/$defs/Timestamp"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "redactedParameters": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "EvidenceEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/CommonObject"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "metadata",
            "provenance",
            "evidence"
          ],
          "properties": {
            "kind": {
              "const": "EvidenceEvent"
            },
            "metadata": {
              "$ref": "#/$defs/ObjectMetadata"
            },
            "provenance": {
              "$ref": "#/$defs/ObjectProvenance"
            },
            "evidence": {
              "type": "object",
              "required": [
                "occurredAt",
                "workEnvelopeReference",
                "eventType",
                "payload"
              ],
              "properties": {
                "occurredAt": {
                  "$ref": "#/$defs/Timestamp"
                },
                "workEnvelopeReference": {
                  "$ref": "#/$defs/Reference"
                },
                "eventType": {
                  "$ref": "#/$defs/NonEmptyString"
                },
                "payload": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ChangeAction": {
      "type": "object",
      "required": [
        "schema",
        "version",
        "kind",
        "metadata",
        "graphContext",
        "intent",
        "specification",
        "review",
        "acceptanceCriteria"
      ],
      "properties": {
        "schema": {
          "enum": [
            "https://opendataproducts.org/odph-v0.2/schema/change-control.yaml",
            "https://opendataproducts.org/odph-v0.2/schema/change-control.json"
          ]
        },
        "version": {
          "const": "0.2-draft"
        },
        "kind": {
          "const": "ChangeAction"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "graphContext": {
          "$ref": "#/$defs/GraphContext"
        },
        "intent": {
          "$ref": "#/$defs/Intent"
        },
        "specification": {
          "$ref": "#/$defs/SpecificationChange"
        },
        "review": {
          "$ref": "#/$defs/Review"
        },
        "acceptanceCriteria": {
          "$ref": "#/$defs/AcceptanceCriteria"
        }
      },
      "additionalProperties": false
    },
    "ChangeTask": {
      "type": "object",
      "required": [
        "schema",
        "version",
        "kind",
        "metadata",
        "graphContext",
        "intent",
        "actions",
        "review",
        "acceptanceCriteria"
      ],
      "properties": {
        "schema": {
          "enum": [
            "https://opendataproducts.org/odph-v0.2/schema/change-control.yaml",
            "https://opendataproducts.org/odph-v0.2/schema/change-control.json"
          ]
        },
        "version": {
          "const": "0.2-draft"
        },
        "kind": {
          "const": "ChangeTask"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "graphContext": {
          "$ref": "#/$defs/GraphContext"
        },
        "intent": {
          "$ref": "#/$defs/Intent"
        },
        "actions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/ActionReference"
          }
        },
        "review": {
          "$ref": "#/$defs/Review"
        },
        "acceptanceCriteria": {
          "$ref": "#/$defs/AcceptanceCriteria"
        }
      },
      "additionalProperties": false
    }
  }
}
