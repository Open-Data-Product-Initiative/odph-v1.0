{"id":"ContextPackage","definition":"A bounded observation of authorized context with source provenance, freshness, and observed conflicts.","requiredFields":["id","kind","version","createdAt","actor","sourceReferences","relationshipReferences","retrievalScope","freshness","conflicts"],"doUseFor":["task-scoped sourced context","explicit freshness and conflict reporting"],"doNotUseFor":["a shadow copy of a portfolio","claiming a source is universally consistent"],"exampleFile":"/examples/context-package.yaml"}
{"id":"Mandate","definition":"The durable outer boundary for a business area: scope, tools, data access, approvals, authority, owner, and expiry.","requiredFields":["id","kind","businessArea","owner","scope","tools","dataAccess","approvalRights","authorityLevel","expiresAt"],"doUseFor":["a durable upper boundary","periodically reviewed ownership"],"doNotUseFor":["a one-off task plan","portable meanings for an undefined numeric authority level"],"exampleFile":"/examples/mandate.yaml"}
{"id":"WorkEnvelope","definition":"An assignment-specific boundary that is a strict subset of exactly one Mandate version.","requiredFields":["id","kind","mandateReference","requestedResult","owner","scope","tools","dataAccess","approvalRights","authorityLevel","expiresAt"],"doUseFor":["one bounded assignment","requested result and review horizon"],"doNotUseFor":["expanding a Mandate","independent authority"],"exampleFile":"/examples/work-envelope.yaml"}
{"id":"ExecutionPackage","definition":"A non-authoritative plan that remains within one WorkEnvelope boundary.","requiredFields":["id","kind","workEnvelopeReference","plannedSteps","expectedOutputs","dependencies","timing","acceptanceCriteria"],"doUseFor":["planned work and acceptance criteria","draft outputs"],"doNotUseFor":["an autonomous runbook","new authority"],"exampleFile":"/examples/execution-package.yaml"}
{"id":"ExecutionRequest","definition":"One explicit proposed action under an ExecutionPackage and RevocationPolicy.","requiredFields":["id","kind","executionPackageReference","revocationPolicyReference","action","tool","target","requestedAuthority","approvalRequired","approvalExpiresAt"],"doUseFor":["one proposed action","deterministic local evaluation"],"doNotUseFor":["an implicit command","raw secrets"],"exampleFile":"/examples/execution-request.yaml"}
{"id":"RevocationPolicy","definition":"A cross-cutting control defining a future suspension, narrowing, and restoration path for a request authority chain.","requiredFields":["id","kind","policyId","scope","authorityChain","suspensionTriggers","localStatus"],"doUseFor":["future execution-capable profiles","simulated local suspension"],"doNotUseFor":["claiming a live credential was suspended","a separate competing policy identifier"],"exampleFile":"/examples/revocation-policy.yaml"}
{"id":"EvidenceEvent","definition":"The durable atomic attributable record in a logical EvidenceBundle export.","requiredFields":["id","kind","occurredAt","workEnvelopeReference","eventType","payload"],"doUseFor":["context retrieval","validation, output, or correction evidence"],"doNotUseFor":["claiming immutable retention","evidence without source provenance"],"exampleFile":"/examples/evidence-event.yaml"}
{"id":"Correction","definition":"Attributable feedback naming an object version, correction kind, destination, and summary.","requiredFields":["id","kind","targetReference","correctionKind","destination","summary"],"doUseFor":["recorded output, context, mandate, policy, or tool feedback"],"doNotUseFor":["silently rewriting the target","feedback without a destination"],"exampleFile":"/examples/correction.yaml"}
