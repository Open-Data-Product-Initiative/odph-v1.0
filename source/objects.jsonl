{"id":"ContextPackage","definition":"A bounded observation of sourced context, including retrieval scope, versioned references, freshness, and observed conflicts.","requiredFields":["id","kind","version","createdAt","actor","sourceReferences","relationshipReferences","retrievalScope","freshness","conflicts"],"doUseFor":["bounded source context","explicit freshness and conflict reporting"],"doNotUseFor":["a shadow portfolio copy","claiming universal source consistency"],"exampleFile":"examples/context-package.yaml"}
{"id":"Mandate","definition":"The durable business boundary for an area: scope, tools, data access, approval rights, authority level, owner, and expiry.","requiredFields":["id","kind","version","createdAt","actor","sourceReferences","relationshipReferences","businessArea","owner","scope","tools","dataAccess","approvalRights","authorityLevel","expiresAt"],"doUseFor":["a durable outer boundary","periodically reviewed ownership"],"doNotUseFor":["a one-off task plan","an external permission grant"],"exampleFile":"examples/mandate.yaml"}
{"id":"WorkEnvelope","definition":"An assignment-specific boundary that must be a subset of exactly one Mandate version.","requiredFields":["id","kind","version","createdAt","actor","sourceReferences","relationshipReferences","mandateReference","requestedResult","owner","scope","tools","dataAccess","approvalRights","authorityLevel","expiresAt"],"doUseFor":["one bounded assignment","requested result and review horizon"],"doNotUseFor":["expanding a Mandate","independent authority"],"exampleFile":"examples/work-envelope.yaml"}
{"id":"ExecutionPackage","definition":"A non-authoritative plan that remains within one WorkEnvelope boundary.","requiredFields":["id","kind","version","createdAt","actor","sourceReferences","relationshipReferences","workEnvelopeReference","plannedSteps","expectedOutputs","dependencies","timing","acceptanceCriteria"],"doUseFor":["planned work and acceptance criteria","reviewable draft outputs"],"doNotUseFor":["an autonomous runbook","new authority"],"exampleFile":"examples/execution-package.yaml"}
{"id":"ExecutionRequest","definition":"One explicit proposed action under an ExecutionPackage and revocation policy.","requiredFields":["id","kind","version","createdAt","actor","sourceReferences","relationshipReferences","executionPackageReference","revocationPolicyReference","action","tool","target","requestedAuthority","approvalRequired","approvalExpiresAt"],"doUseFor":["one proposed action","deterministic evaluation"],"doNotUseFor":["an implicit command","raw secrets"],"exampleFile":"examples/execution-request.yaml"}
{"id":"EvidenceEvent","definition":"The durable atomic attributable record for context, validation, review, submission, outcome, or reconciliation evidence.","requiredFields":["id","kind","version","createdAt","actor","sourceReferences","relationshipReferences","occurredAt","workEnvelopeReference","eventType","payload"],"doUseFor":["attributable evidence","source provenance"],"doNotUseFor":["claiming immutable retention","evidence without references"],"exampleFile":"examples/evidence-event.yaml"}
{"id":"ChangeAction","definition":"One agreed direct Maysano API operation that references exactly one separately validated ODPC, ODPS, or ODPG YAML file.","requiredFields":["schema","version","kind","metadata","graphContext","intent","specification","review","acceptanceCriteria"],"doUseFor":["one create or update of one specification file","guided v0.2 resource-level workflows"],"doNotUseFor":["embedded business-object content","multi-action atomic execution","generic link or deprecate operations"],"exampleFile":"examples/change-chain/actions/tc01-create-objective.yaml"}
{"id":"ChangeTask","definition":"A composite business change that references separately validated ChangeAction files and their dependencies.","requiredFields":["schema","version","kind","metadata","graphContext","intent","actions","review","acceptanceCriteria"],"doUseFor":["dependency-ordered composite business changes","reviewing multiple existing actions together"],"doNotUseFor":["copying ODPC, ODPS, or ODPG content","claiming server-side atomic execution"],"exampleFile":"examples/change-chain/change-tasks/change-chain.yaml"}
